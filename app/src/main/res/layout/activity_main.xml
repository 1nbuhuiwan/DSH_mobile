<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ds_bg">

    <!-- ================= 浏览器模式 ================= -->
    <LinearLayout
        android:id="@+id/browserView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/ds_bg"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- 地址栏 / 工具栏 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/ds_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_icon_button"
                android:contentDescription="@string/app_name"
                android:scaleType="centerInside"
                android:padding="9dp"
                android:src="@drawable/ic_back"
                android:enabled="false" />

            <ImageButton
                android:id="@+id/btnForward"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_icon_button"
                android:contentDescription="@string/app_name"
                android:scaleType="centerInside"
                android:padding="9dp"
                android:src="@drawable/ic_forward"
                android:enabled="false" />

            <ImageButton
                android:id="@+id/btnReload"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_icon_button"
                android:contentDescription="@string/app_name"
                android:scaleType="centerInside"
                android:padding="9dp"
                android:src="@drawable/ic_reload" />

            <!-- 顶栏标题：显示当前项目 / 会话名称 -->
            <TextView
                android:id="@+id/projectTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:text="@string/app_name"
                android:textColor="@color/ds_ink"
                android:textSize="15sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btnHome"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_icon_button"
                android:contentDescription="@string/app_name"
                android:scaleType="centerInside"
                android:padding="9dp"
                android:src="@drawable/ic_home" />

            <ImageButton
                android:id="@+id/btnScan"
                android:layout_width="48dp"
                android:layout_height="40dp"
                android:layout_marginStart="2dp"
                android:contentDescription="@string/home_scan_title"
                android:scaleType="centerInside"
                android:src="@drawable/ic_scan"
                android:tint="@color/ds_brand" />
        </LinearLayout>

        <!-- WebView 浏览器区 -->
        <WebView
            android:id="@+id/webView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@color/ds_bg" />
    </LinearLayout>

    <!-- ================= 首页（未连接） ================= -->
    <ScrollView
        android:id="@+id/homeView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/ds_bg"
        android:fillViewport="true"
        android:scrollbars="none">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="28dp"
            android:paddingEnd="28dp"
            android:paddingTop="42dp"
            android:paddingBottom="28dp">

            <!-- 品牌 -->
            <ImageView
                android:layout_width="76dp"
                android:layout_height="76dp"
                android:contentDescription="@string/app_name"
                android:src="@drawable/ic_launcher" />

            <TextView
                android:id="@+id/titleText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="@string/home_heading"
                android:textColor="@color/ds_ink"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/subtitleText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:lineSpacingExtra="2dp"
                android:text="@string/home_lead"
                android:textColor="@color/ds_muted"
                android:textSize="14sp" />

            <!-- 扫码连接卡片 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="34dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/home_scan_title"
                    android:textColor="@color/ds_ink"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/scanHintText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:lineSpacingExtra="2dp"
                    android:text="@string/home_scan_sub"
                    android:textColor="@color/ds_muted"
                    android:textSize="13sp" />

                <!-- 主按钮 -->
                <LinearLayout
                    android:id="@+id/btnScanConnect"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_brand_button"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:elevation="2dp"
                    android:stateListAnimator="@animator/brand_press_lift"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:contentDescription="@string/home_scan_title"
                        android:src="@drawable/ic_scan" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:text="@string/home_scan_title"
                        android:textColor="@color/ds_brand_ink"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- 手动输入 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:layout_marginBottom="8dp"
                android:text="@string/home_manual_hint"
                android:textColor="@color/ds_muted"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/manualUrlInput"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_edit"
                    android:gravity="center_vertical"
                    android:hint="@string/home_address_hint"
                    android:imeOptions="actionGo"
                    android:inputType="textUri"
                    android:maxLines="1"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:singleLine="true"
                    android:textColor="@color/ds_ink"
                    android:textColorHint="@color/ds_muted"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/btnConnect"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/bg_brand_button"
                    android:gravity="center"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:elevation="2dp"
                    android:stateListAnimator="@animator/brand_press_lift"
                    android:text="@string/home_connect"
                    android:textColor="@color/ds_brand_ink"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- 底部提示 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:gravity="center"
                android:text="@string/app_subtitle"
                android:textColor="@color/ds_muted"
                android:textSize="12sp" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
